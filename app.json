{
  "expo": {
    "name": "Kiln",
    "slug": "kiln",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./design/shots/r3/icon.png",
    "scheme": "kiln",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./design/shots/r3/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "bundleIdentifier": "si.aiken.kiln"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0B0D",
        "foregroundImage": "./design/shots/r3/icons/icon-android-layer-fg.png",
        "backgroundImage": "./design/shots/r3/icons/icon-android-layer-bg.png",
        "monochromeImage": "./design/shots/r3/icons/icon-android-layer-mono.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0B0D",
          "image": "./design/shots/r3/icons/icon-android-full.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9e4055fc-8497-44ff-8b24-dce403284d87"
      }
    },
    "owner": "aiken"
  }
}
